{
  "title": "Email review findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "Path to the email file, from the project root." },
          "line": { "type": "number", "description": "Line number where the problem is." },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "problem": { "type": "string", "description": "What is wrong, in plain English." },
          "fix": { "type": "string", "description": "How to fix it, in plain English." }
        },
        "required": ["file", "line", "severity", "problem", "fix"],
        "additionalProperties": false
      }
    }
  },
  "required": ["findings"],
  "additionalProperties": false
}
